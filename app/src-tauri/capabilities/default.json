{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, terminal, diagram and NexHost panel windows",
  "windows": [
    "main",
    "terminal-*",
    "diagram-*",
    "nexhost-panel"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:allow-restart"
  ]
}
